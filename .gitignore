# ==============================================================================
# HerSignal (.gitignore)
# Root ignore file for Flutter (Frontend), Node.js (Backend), IDEs, and Environment Secrets
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Secrets & Credentials (NEVER COMMIT REAL SECRETS)
# ------------------------------------------------------------------------------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
*.pem
*.key
*.cert

# Ensure sample environment files remain tracked
!.env.example

# ------------------------------------------------------------------------------
# 2. Node.js & Backend
# ------------------------------------------------------------------------------
node_modules/
jspm_packages/
package-lock.json.bak
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# 3. Flutter & Dart (Frontend)
# ------------------------------------------------------------------------------
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.packages
.pub-cache/
.pub/
build/
coverage/

# Android specific (within Flutter)
android/**/gradle-wrapper.jar
android/.gradle
android/captures/
android/gradlew
android/gradlew.bat
android/local.properties
android/**/GeneratedPluginRegistrant.java
*.apk
*.ap_
*.aab

# iOS specific (within Flutter)
ios/**/frameworks/
ios/Pods/
ios/.symlinks/
ios/Flutter/Flutter.framework
ios/Flutter/Flutter.podspec
ios/Flutter/Generated.xcconfig
ios/Flutter/app.framework
ios/**/GeneratedPluginRegistrant.h
ios/**/GeneratedPluginRegistrant.m

# Web specific (within Flutter)
frontend/build/web/

# ------------------------------------------------------------------------------
# 4. IDEs and Editors
# ------------------------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.project
.classpath
.c9/
*.launch
*.sublime-workspace
*.sublime-project

# ------------------------------------------------------------------------------
# 5. Operating System Files
# ------------------------------------------------------------------------------
# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msm
*.msp
*.lnk

# macOS
.DS_Store
.AppleDouble
.LSOverride
Icon
._*

# Linux
*~
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# 6. Logs, Caches, & Temporary Scratchpads
# ------------------------------------------------------------------------------
logs
*.log
*.tmp
*.temp
scratch/
