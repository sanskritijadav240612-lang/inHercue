# ==============================================================================
# HerSignal Backend Environment Variables (TEMPLATE / EXAMPLE)
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env' in this directory:
#      copy .env.example .env
# 2. Update the values below for your local environment.
# 3. NEVER commit real credentials, database passwords, or JWT secrets to Git.
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# Database Connection (MongoDB)
# Leave empty or set to your local MongoDB connection string when available.
# Example: mongodb://localhost:27017/hersignal_dev
# Note: In Phase 1 foundation, backend operates in standalone mode if omitted.
MONGODB_URI=

# Authentication Secrets
# In production, replace with a 64+ character cryptographically random string.
JWT_SECRET=your_development_jwt_secret_placeholder_do_not_use_in_prod
JWT_EXPIRES_IN=7d

# CORS Configuration
# Allowed frontend origin (e.g., http://localhost:3000 or * during local testing)
CORS_ORIGIN=*
